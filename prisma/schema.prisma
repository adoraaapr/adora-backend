generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  RIDER
  ADMIN
  CUSTOMER
}

enum RiderStatus {
  PENDING
  ACTIVE
  BLOCKED
}

enum OrderStatus {
  CREATED
  PAID
  FAILED
  REFUND_PENDING
  REFUNDED
}

enum AdStatus {
  PENDING_APPROVAL
  APPROVED
  RUNNING
  COMPLETED
  REJECTED
}

enum AssignmentStatus {
  ACTIVE
  REMOVED
  COMPLETED
}

enum LogStatus {
  SUBMITTED
  VERIFIED
  REJECTED
}

enum PayoutStatus {
  PENDING
  PAID
}

model User {
  id               String         @id @default(cuid()) @map("_id")
  role             Role
  name             String
  phone            String         @unique
  email            String?        @unique
  passwordHash     String
  refreshTokenHash String?
  tokenVersion     Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  rider            Rider?
  assignments      AdAssignment[]
  logs             DailyLog[]
  locations        Location[]
  payouts          Payout[]
  auditLogs        AuditLog[]     @relation("AuditActor")

  @@index([role, createdAt])
}

model Rider {
  id        String      @id @default(cuid()) @map("_id")
  userId    String      @unique
  vehicleNo String?
  city      String?
  upiId     String?
  status    RiderStatus @default(PENDING)
  deletedAt DateTime?
  user      User        @relation(fields: [userId], references: [id])

  @@index([status, city])
}

model Customer {
  id               String   @id @default(cuid()) @map("_id")
  name             String
  phone            String
  email            String   @unique
  company          String?
  passwordHash     String
  refreshTokenHash String?
  tokenVersion     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  orders           Order[]
  ads              Ad[]

  @@index([phone])
}

model AdPlan {
  id             String    @id @default(cuid()) @map("_id")
  name           String
  description    String?
  durationDays   Int
  ridersCount    Int
  pricePaise     BigInt
  ratePerKmPaise Int       @default(200)
  active         Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  orders         Order[]
  ads            Ad[]

  @@index([active, deletedAt])
}

model Order {
  id                String      @id @default(cuid()) @map("_id")
  customerId        String
  planId            String
  amountPaise       BigInt
  currency          String      @default("INR")
  razorpayOrderId   String?     @unique
  razorpayPaymentId String?     @unique
  status            OrderStatus @default(CREATED)
  idempotencyKey    String?     @unique
  failureReason     String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  customer          Customer    @relation(fields: [customerId], references: [id])
  plan              AdPlan      @relation(fields: [planId], references: [id])
  ad                Ad?

  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

model Ad {
  id               String         @id @default(cuid()) @map("_id")
  customerId       String
  orderId          String         @unique
  planId           String
  title            String?
  creativeUrl      String?
  creativePublicId String?
  status           AdStatus       @default(PENDING_APPROVAL)
  startDate        DateTime?
  endDate          DateTime?
  rejectionReason  String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  customer         Customer       @relation(fields: [customerId], references: [id])
  order            Order          @relation(fields: [orderId], references: [id])
  plan             AdPlan         @relation(fields: [planId], references: [id])
  assignments      AdAssignment[]
  logs             DailyLog[]

  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([endDate, status])
}

model AdAssignment {
  id         String           @id @default(cuid()) @map("_id")
  adId       String
  riderId    String
  assignedAt DateTime         @default(now())
  status     AssignmentStatus @default(ACTIVE)
  ad         Ad               @relation(fields: [adId], references: [id])
  rider      User             @relation(fields: [riderId], references: [id])

  @@unique([adId, riderId])
  @@index([riderId, status])
  @@index([adId, status])
}

model DailyLog {
  id                 String    @id @default(cuid()) @map("_id")
  riderId            String
  adId               String
  logDate            DateTime
  startKm            Float
  endKm              Float?
  startPhotoUrl      String
  startPhotoPublicId String?
  endPhotoUrl        String?
  endPhotoPublicId   String?
  adPhotoUrl         String?
  adPhotoPublicId    String?
  status             LogStatus @default(SUBMITTED)
  adminNote          String?
  suspicious         Boolean   @default(false)
  suspiciousReason   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  rider              User      @relation(fields: [riderId], references: [id])
  ad                 Ad        @relation(fields: [adId], references: [id])

  @@unique([riderId, adId, logDate])
  @@index([status, logDate])
  @@index([riderId, logDate])
  @@index([adId, logDate])
}

model Location {
  id         String   @id @default(cuid()) @map("_id")
  riderId    String
  lat        Float
  lng        Float
  recordedAt DateTime @default(now())
  rider      User     @relation(fields: [riderId], references: [id])

  @@index([riderId, recordedAt])
  @@index([recordedAt])
}

model Payout {
  id             String       @id @default(cuid()) @map("_id")
  riderId        String
  periodStart    DateTime
  periodEnd      DateTime
  totalKm        Float
  ratePerKmPaise Int
  amountPaise    BigInt
  status         PayoutStatus @default(PENDING)
  paidAt         DateTime?
  reference      String?
  createdAt      DateTime     @default(now())
  rider          User         @relation(fields: [riderId], references: [id])

  @@unique([riderId, periodStart, periodEnd])
  @@index([status, periodEnd])
}

model WebhookEvent {
  id          String    @id @default(cuid()) @map("_id")
  eventId     String    @unique
  eventType   String
  payload     Json
  processedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())

  @@index([processedAt, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid()) @map("_id")
  actorId    String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  requestId  String?
  createdAt  DateTime @default(now())
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
}
